# ==============================================================================
# FinsightAI - Environment Configuration Template
# Copy this file to '.env' and adjust values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# App Configuration
# ------------------------------------------------------------------------------
PROJECT_NAME="FinsightAI"
# Options: local, development, staging, production
ENVIRONMENT=local
DEBUG=true

# ------------------------------------------------------------------------------
# API Configuration
# ------------------------------------------------------------------------------
API_V1_STR="/api/v1"
# CORS Origins (JSON array or comma-separated list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finsightai

# ------------------------------------------------------------------------------
# Redis & Celery Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
# Optional: Can be auto-assembled if left blank
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# AI & LLM Configuration
# ------------------------------------------------------------------------------

# --- LLM: OpenRouter (Sole LLM Provider) ---
# OpenRouter is an OpenAI-compatible API gateway giving access to hosted models.
# Get your free API key at: https://openrouter.ai/keys
# Do NOT commit real API keys to version control.
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Model identifier on OpenRouter. Recommended: openrouter/free (auto-routes to a free model)
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PRIMARY_LLM_PROVIDER=openrouter

# --- Embeddings: BGE-M3 via Ollama (replaces Nomic/nomic-embed-text) ---
# BGE-M3 is served via your local Ollama instance, just like the previous Nomic model.
# REQUIRED SETUP: Run `ollama pull bge-m3` on your Ollama host before first use.
# BGE-M3 outputs 1024-dimensional vectors (Nomic was 768-dim).
#
# ⚠ RE-EMBEDDING WARNING ⚠
# If you are upgrading from nomic-embed-text, ALL existing stored embeddings
# (vector(768)) are incompatible with BGE-M3 (vector(1024)).
# After running `alembic upgrade head`:
#   1. The migration deletes all existing document_chunks rows automatically.
#   2. Re-trigger ingestion for all documents via the Celery task.
# Mixing old Nomic vectors with new BGE-M3 vectors silently corrupts search results.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# LLM generation via Ollama (e.g. phi3:mini) has been removed.
# OLLAMA_GENERATION_ENABLED and OLLAMA_GENERATION_MODEL are no longer used.

# ------------------------------------------------------------------------------
# JWT Authentication Configuration
# ------------------------------------------------------------------------------
# Secret key for signing tokens (run 'openssl rand -hex 32' to generate one)
JWT_SECRET_KEY=your-super-secret-jwt-signing-key-value-goes-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# MinIO Object Storage Configuration
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=finsightai-documents
MINIO_SECURE=false

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
